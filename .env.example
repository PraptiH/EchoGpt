# Public URL of this landing page (used for canonical URLs, Open Graph, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://echogpt.ai

# Base URL of the EchoGPT web app (downloads, docs, status)
NEXT_PUBLIC_APP_URL=https://app.echogpt.ai

# Endpoint that receives waitlist signups as JSON ({ email, createdAt, source }), e.g. a Zapier,
# Make or CRM webhook. When unset, signups are appended to .data/waitlist.jsonl instead.
WAITLIST_WEBHOOK_URL=
